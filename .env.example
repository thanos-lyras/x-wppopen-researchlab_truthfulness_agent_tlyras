# ─── Required ─────────────────────────────────────────────────────────
# GCP project + region. Locally these auto-detect from `gcloud auth
# application-default login`; set them here so deploy scripts also work.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=True

# ─── Models (override to swap the LLM behind each layer) ──────────────
ORCHESTRATOR_MODEL=gemini-2.5-flash
ZERO_SHOT_MODEL=gemini-2.5-flash
EXPLAINER_MODEL=gemini-2.5-flash
FINE_TUNED_AGENT_MODEL=gemini-2.5-flash

# ─── Local dev ports ──────────────────────────────────────────────────
ORCHESTRATOR_A2A_PORT=8000
ZERO_SHOT_A2A_PORT=8001
FINE_TUNED_A2A_PORT=8002
EXPLAINER_A2A_PORT=8003
MCP_SERVER_PORT=8004

# ─── Fine-tuning (Vertex AI Gemini SFT) ───────────────────────────────
FINE_TUNED_BASE_MODEL=gemini-2.5-flash-lite
FINE_TUNED_EPOCHS=5
FINE_TUNED_ADAPTER_SIZE=ADAPTER_SIZE_SIXTEEN
FINE_TUNED_LRM=1.0

# ─── Auto-populated by deploys — leave blank on a fresh clone ─────────
# `terraform apply` (or `make deploy-all`) writes GCS_BUCKET + the 5 URLs.
# `make register-orchestrator-gateway` writes the 3 A2A_GATEWAY_* vars.
# `make finetune` writes FINE_TUNED_MODEL + LAST_TUNING_JOB on job completion.
GCS_BUCKET=
MCP_SERVER_URL=
ZERO_SHOT_A2A_URL=
FINE_TUNED_A2A_URL=
EXPLAINER_A2A_URL=
ORCHESTRATOR_A2A_URL=
A2A_GATEWAY_BASE_URL=
A2A_GATEWAY_AGENT_ID=
A2A_GATEWAY_TRUTHFULNESS_ORCHESTRATOR_BEARER_TOKEN=
FINE_TUNED_MODEL=
LAST_TUNING_JOB=

# ─── Optional overrides ───────────────────────────────────────────────
# Caller identity for the gateway `X-A2A-Caller` header (falls back to
# `gcloud config get-value account` if unset).
# A2A_CALLER_EMAIL=your.name@satalia.com

# Bucket + tuning-job regions (default to europe-west1 to match GOOGLE_CLOUD_LOCATION).
# GCS_LOCATION=europe-west1
# TUNING_LOCATION=europe-west1
