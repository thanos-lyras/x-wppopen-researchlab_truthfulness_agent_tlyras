# GCP project / location / Vertex flag.
# Locally these auto-detect from gcloud ADC (see agents/__init__.py); set them
# explicitly so deploy scripts work in CI / non-interactive contexts. Use
# `europe-west1` (or another regional endpoint) — `global` rejects Vertex SFT.
# This project runs in europe-west1 to colocate with the shared A2A Agents
# Gateway (a2a-agent-gateway-eu-...ew.a.run.app), which cuts gateway→orchestrator
# latency from ~120ms trans-Atlantic to sub-10ms same-region.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=True

# Model used by the orchestrator (routes/delegates to sub-agents; never calls tools directly).
ORCHESTRATOR_MODEL=gemini-2.5-flash
# Model used by the zero-shot predictor agent.
ZERO_SHOT_MODEL=gemini-2.5-flash
# Model used by the `explain_truthfulness` MCP tool to write the natural-language
# explanations. Must be a free-form model (the tuned model can only output True/False).
EXPLAINER_MODEL=gemini-2.5-flash

# A2A ports per agent — read by each agent's `a2a_app = to_a2a(..., port=…)`
# and by the Makefile's `make run-a2a NAME=<name>` target.
# Convention: <AGENT_NAME_UPPER>_A2A_PORT.
ORCHESTRATOR_A2A_PORT=8000
ZERO_SHOT_A2A_PORT=8001
FINE_TUNED_A2A_PORT=8002
EXPLAINER_A2A_PORT=8003

# MCP tool server (shared across agents) — exposes predict/explain/etc.
# Read by `make run-mcp` and by each agent's tools.py manifest.
MCP_SERVER_PORT=8004

# ── Fine-tuning (Vertex AI Gemini SFT) ────────────────────────────────────
# GCS bucket used to upload train/val JSONL for SFT (must exist in your project).
GCS_BUCKET=
# Base model for SFT and SFT hyperparameters (defaults to lite for cost).
FINE_TUNED_BASE_MODEL=gemini-2.5-flash-lite
FINE_TUNED_EPOCHS=5
FINE_TUNED_ADAPTER_SIZE=ADAPTER_SIZE_SIXTEEN
FINE_TUNED_LRM=1.0
# Deployed-endpoint path of the tuned model, e.g.
#   projects/<num>/locations/europe-west1/endpoints/<id>
# `make finetune` / `make sync-tuned-model` / `check_finetune_status` write this
# automatically after the SFT job succeeds. If left empty, predict_fine_tuned_truthfulness
# falls back to FINE_TUNED_BASE_MODEL so wiring stays smoke-testable.
# Read by the MCP `predict_truthfulness` tool (prediction layer), NOT by the agent itself.
FINE_TUNED_MODEL=
# LLM the wrapping fine-tuned ADK agent uses for tool routing / response formatting.
# Distinct from FINE_TUNED_MODEL above (which is the prediction endpoint). Leave
# unset to use the gemini-2.5-flash default; override only when you want a
# different model at the agent layer than the prediction layer.
FINE_TUNED_AGENT_MODEL=gemini-2.5-flash
# Pointer to the last SFT job submitted — TuningService.submit() writes this
# automatically so the `check_finetune_status` MCP tool can poll the job and
# self-heal FINE_TUNED_MODEL when training completes. Leave blank initially.
LAST_TUNING_JOB=

# ── A2A Gateway (bearer-token access to the orchestrator) ────────────────
# The orchestrator is fronted by the shared A2A Agents Gateway (see
# `make register-orchestrator-gateway`). Callers POST to
# `${A2A_GATEWAY_BASE_URL}/agents/${A2A_GATEWAY_AGENT_ID}/` with:
#   Authorization: Bearer ${A2A_GATEWAY_TRUTHFULNESS_ORCHESTRATOR_BEARER_TOKEN}
#   X-A2A-Caller: ${A2A_CALLER_EMAIL}
# The token is minted into Secret Manager by upsert_gateway_bearer_secret.py;
# copy it into the team vault AND paste it here (never commit .env).
# A2A_GATEWAY_BASE_URL=https://a2a-agent-gateway-eu-fq5fpdmt7a-ew.a.run.app
# A2A_GATEWAY_AGENT_ID=truthfulness-orchestrator
# A2A_GATEWAY_TRUTHFULNESS_ORCHESTRATOR_BEARER_TOKEN=
# A2A_CALLER_EMAIL=your.name@satalia.com
